<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="InterfaceOptionsPanels.lua"/>
	
	<!-- Cheese panel -->
	
	<Frame name="InterfaceOptionsCheesePanel" hidden="true" parent="InterfaceOptionsFramePanelContainer">
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" text="CHEESE_LABEL" inherits="GameFontNormalLarge" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="16" y="-16"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentSubText" text="CHEESE_SUBTEXT" inherits="GameFontHighlightSmall" nonspacewrap="true" maxLines="3" justifyH="LEFT" justifyV="TOP">
					<Size>
						<AbsDimension y="32" x="0"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="0" y="-8"/>
							</Offset>
						</Anchor>
						<Anchor point="RIGHT">
							<Offset>
								<AbsDimension x="-32" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>		
			<CheckButton name="$parentShowSpellAlerts" inherits="InterfaceOptionsCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentSubText" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="-2" y="-8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName() .. "Text"]:SetText(CHEESE_DISPLAY_SPELL_ALERTS);
					</OnLoad>
					<OnClick>
						CheeseOptions_SetAlerts(self:GetChecked());
					</OnClick>
				</Scripts>
			</CheckButton>
			<Slider name="$parentSpellAlertOpacitySlider" inherits="OptionsSliderTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentShowSpellAlerts" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="24" y="-8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetMinMaxValues(0.1, 1);
						self:SetValueStep(0.05);
						_G[self:GetName() .. "Text"]:SetText(CHEESE_SPELL_ALERT_OPACITY);
						_G[self:GetName() .. "Low"]:SetText("10%");
						_G[self:GetName() .. "High"]:SetText("100%");
					</OnLoad>
					<OnValueChanged>
						CheeseOptions_SetOpacity(value);
					</OnValueChanged>
				</Scripts>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad>
				self.name = CHEESE_LABEL;
				self.refresh = CheeseOptions_Refresh;
			</OnLoad>
			<OnShow>
				CheeseOptions_Refresh(self);
			</OnShow>
		</Scripts>
	</Frame>
</Ui>
